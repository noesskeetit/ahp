# Append to an isolated local composition environment. No credentials here.
# Hindsight dependencies (compose.memory.yaml): use URL-safe hex DB password.
AHP_HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:1.1.0
AHP_HINDSIGHT_DB_PASSWORD=
AHP_HINDSIGHT_MODEL_BASE_URL=
AHP_HINDSIGHT_MODEL=
AHP_HINDSIGHT_MODEL_API_KEY=
AHP_HINDSIGHT_PORT=38888

# Existing ahp binary, built with ahp_data; Identity mode and data planes required.
AHP_ENABLE_DATA=1
AHP_ENABLE_BROWSER=1
AHP_ENABLE_MEMORY=1
AHP_MEMORY_BACKEND=hindsight
AHP_MEMORY_HINDSIGHT_URL=http://127.0.0.1:38888
# Only for deployments explicitly allowed to send direct runtime events.
# The trusted in-process State outbox consumer does not require this allowlist.
AHP_MEMORY_RUNTIME_DEPLOYMENTS=
AHP_MEMORY_CONTROL_DEPLOYMENTS=

# Existing as-runner: same private HTTPS origin as the composed AHP task API.
# Set AS_STATE_URL, workload certificate/key/CA and native Identity config too.
AS_MEMORY_URL=
# MERGE these with your deployment's capabilities; do not overwrite other caps.
AS_RUN_GRANT_CAPS=state,memory
# Console settings require native memory:review, clear requires memory:delete.
# Assign these to the human ingress grant using the existing Identity policy.
