# Example environment for the class X Firecracker supervisor (Linux/KVM only).
#
# Copy to /etc/ahp/compute-supervisor.env and adjust paths to the images the
# operator (kvm-lab) provides. This file embeds NO URLs and NO secrets; the
# images themselves are an EXTERNAL prerequisite, not part of this repository.
#
# Run:  compute-host supervise   (reads AHP_COMPUTE_SUPERVISOR_SOCKET + the vars below)

# Which microVM runtime to build. Currently only "firecracker" has an in-tree
# implementation. "kata" is recognised by the architecture but refuses to start
# until an operator supplies a Kata VMRuntime to the supervisor.
AHP_COMPUTE_RUNTIME=firecracker

# Unix socket the supervisor serves the class X protocol on. Must match the
# AHP_COMPUTE_FC_SOCKET configured for the compute-host control plane.
AHP_COMPUTE_SUPERVISOR_SOCKET=/run/ahp/compute-fc.sock

# Required images/tools (existence checked by kvm-check.sh; supplied EXTERNALLY).
AHP_FC_BINARY=/usr/local/bin/firecracker
AHP_FC_KERNEL=/var/lib/ahp-compute/images/vmlinux
AHP_FC_ROOTFS=/var/lib/ahp-compute/images/base.ext4
AHP_FC_DATADIR=/var/lib/ahp-compute

# Default machine sizing (per-VM overrides come from the acquire request quota).
AHP_FC_VCPUS=1
AHP_FC_MEM_MB=256

# In-guest agent base URL. WITHOUT this, exec/PTY against a running class X
# sandbox is unavailable (the supervisor cannot run commands inside the VM).
AHP_FC_GUEST_AGENT=http://169.254.0.2:8080

# Optional host networking. EMPTY TapName => the guest is deny-all for egress
# (consistent with the class X egress policy). Set both only when the operator
# has prepared a tap device for the sandbox network.
AHP_FC_TAP=
AHP_FC_GUEST_MAC=
