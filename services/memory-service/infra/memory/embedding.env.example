# Explicit degraded alternative: AHP_MEMORY_SEARCH_MODE=lexical (no embedding URL).
AHP_MEMORY_SEARCH_MODE=hybrid
AHP_MEMORY_EMBEDDING_BASE_URL=https://foundation-models.api.cloud.ru/v1
AHP_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
AHP_MEMORY_EMBEDDING_DIM=1024
# Operator configuration generation, NOT an attestation of upstream weights.
AHP_MEMORY_EMBEDDING_REVISION=fm-bge-m3-config-20261102
AHP_MEMORY_EMBEDDING_PROVIDER=fm-memory-synthetic
AHP_MEMORY_EMBEDDING_POLICY_FILE=infra/memory/embedding-policy.example.json
# Provision an external/ignored mode-0600 file; no credential in this example.
AHP_MEMORY_EMBEDDING_KEY_FILE=
AHP_MEMORY_EMBEDDING_TIMEOUT=30s
# Optional explicit RFC1918/ULA host:port allowlist; never loopback/metadata.
AHP_MEMORY_EMBEDDING_PRIVATE_HOSTS=
