# AHP — шаблон локальных переменных окружения (только плейсхолдеры).
#
# Скопируйте в .env и заполните СВОИМИ значениями. Файл .env игнорируется и
# никогда не коммитится. Значения ниже — не секреты и не рабочие адреса: это
# строки-заглушки, документирующие состав обязательных переменных.
#
# Инфраструктура: docker compose -p ahp-handbook (compose.yaml читает только .env).
# Все порты публикуются только на 127.0.0.1.

# --- PostgreSQL (сервис go-postgres, том go-postgres-data) ---
AHP_POSTGRES_USER=change-me-postgres-user
AHP_POSTGRES_PASSWORD=change-me-postgres-password
AHP_POSTGRES_DB=change-me-postgres-db
AHP_TEST_DATABASE_URL=postgres://change-me-postgres-user:change-me-postgres-password@127.0.0.1:25432/change-me-postgres-db?sslmode=disable

# --- Redis (сервис go-redis, том go-redis-data, appendonly yes) ---
AHP_REDIS_PASSWORD=change-me-redis-password
AHP_TEST_REDIS_URL=redis://:change-me-redis-password@127.0.0.1:26379/0

# --- MinIO / S3 (сервис go-minio, том go-minio-data) ---
# MINIO_ROOT_PASSWORD должен быть не короче 8 символов.
AHP_MINIO_ROOT_USER=change-me-minio-root-user
AHP_MINIO_ROOT_PASSWORD=change-me-minio-root-password
AHP_S3_ENDPOINT=http://127.0.0.1:29000
AHP_S3_REGION=us-east-1

# --- Vault (сервис go-vault, dev-режим, ТОЛЬКО локальная разработка) ---
# Минимальная длина dev-токена Vault — 16 символов.
AHP_VAULT_DEV_TOKEN=change-me-vault-dev-token-0123456789
AHP_VAULT_ADDR=http://127.0.0.1:28200

# --- API (используется npm run smoke; сервис появится в задаче 18) ---
AHP_API_URL=http://127.0.0.1:8080

# Optional Dot Memory profiles; HTTPS origins, workload mTLS, memory/workspace grants.
# Empty values leave the corresponding integration disabled. See docs/dot-shared-project-memory.md.
AS_MEMORY_URL=
AS_WORKSPACE_URL=
AS_SHARED_MEMORY_URL=

# Модель провайдера (Qwen) используется ТОЛЬКО coding-воркерами во время
# разработки и НЕ входит в окружение приложения. Здесь значения нет.
