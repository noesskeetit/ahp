{
  "name": "ahp-handbook",
  "private": true,
  "version": "0.0.0",
  "description": "Dev scripts for the AHP Go platform (fresh implementation). No dependencies; scripts use Node builtins only.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "infra:up": "docker compose -p ahp-handbook up -d --wait go-postgres go-redis go-minio go-vault",
    "infra:minio:build": "node scripts/build-minio.mjs",
    "app:build": "docker compose -p ahp-handbook build go-ahp-all",
    "app:up": "docker compose -p ahp-handbook --profile app up -d --wait",
    "app:down": "docker compose -p ahp-handbook --profile app down",
    "service:run": "node scripts/service-run.mjs",
    "certs:generate": "bash infra/generate-certs.sh",
    "test:go": "node scripts/gotest.mjs",
    "test:go:scoped": "node scripts/gotest.mjs -race -p=1 -count=1",
    "test:go:verdict": "node scripts/skip-verdict.mjs --tags tools/skip-tags.mechanism.json -- go test -json -p=1 -count=1 ./...",
    "test:go:reconnaissance": "node scripts/skip-verdict.mjs --tags tools/skip-tags.mechanism.json --allow-partial -- go test -json -p=1 -count=1 ./...",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:whole-system": "node scripts/run-tests.mjs e2e whole-system",
    "test:space-state": "node scripts/space-state.mjs",
    "test:chaos": "node scripts/run-tests.mjs chaos",
    "test:load": "node scripts/run-tests.mjs load",
    "journey": "node tests/e2e/journey.mjs",
    "demo": "node tests/e2e/demo-ui.mjs",
    "demo:selftest": "node tests/e2e/demo-ui.mjs --selftest",
    "verify:pdf-closure": "node scripts/verify-pdf-closure.mjs",
    "journey:live": "node tests/e2e/live-journey.mjs",
    "vm:plane": "node scripts/vm-plane.mjs",
    "verify:iv": "node scripts/iv-verify.mjs",
    "verify:human-origin": "node --test --test-force-exit scripts/human-origin.test.mjs",
    "verify:skip-verdict": "node --test --test-force-exit scripts/skip-verdict.test.mjs",
    "verify:verdict-entry": "node --test --test-force-exit scripts/verdict-entry.test.mjs",
    "verify:iso": "go build ./internal/... && go vet ./cmd/ahp ./pkg/auth ./internal/identity ./internal/state && go test ./pkg/auth/ && node --test --test-force-exit scripts/human-origin.test.mjs"
  }
}